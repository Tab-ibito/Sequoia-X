# 数据库路径（默认：data/sequoia_v2.db）
DB_PATH=data/sequoia_v2.db

# 数据起始日期（默认：2024-01-01）
START_DATE=2024-01-01

# 默认飞书 Webhook URL（必填，综合报告机器人未配置时使用）
FEISHU_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/your-default-token

# 综合报告专属 Webhook（可选，两部分统一发到此机器人）
# 旧的 STRATEGY_WEBHOOK_MA_VOLUME 等配置仍兼容旧 send()，新主流程不使用。
# STRATEGY_WEBHOOK_REPORT=https://open.feishu.cn/open-apis/bot/v2/hook/your-report-token

# 大模型评估开关：填写接口参数后改为 true。
# BASE_URL 填到 /v1，勿包含 /chat/completions。本地无鉴权服务可留空 API_KEY。
LLM_ENABLED=false
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT=90
LLM_MAX_RETRIES=2
LLM_BATCH_SIZE=10
LLM_MAX_TOKENS=6000
# 某些模型需使用 max_completion_tokens，按服务商协议切换。
LLM_TOKEN_PARAMETER=max_tokens
# 不支持 response_format 的服务可改为 false，输出仍须通过本地 JSON 校验。
LLM_JSON_MODE=true
# 个股行情距评估日最多相差的日历天数，长假需按实际数据调整。
LLM_MAX_DATA_AGE_DAYS=4

# 外部依据：本地 JSON 和 HTTP 服务均可选，契约和示例见 README。
# 不配置时明确输出缺少外部依据，模型不会自行编造新闻或联网来源。
EXTERNAL_EVIDENCE_PATH=
EXTERNAL_EVIDENCE_URL=
EXTERNAL_EVIDENCE_API_KEY=
EXTERNAL_EVIDENCE_TIMEOUT=15
EXTERNAL_EVIDENCE_MAX_AGE_DAYS=30
EXTERNAL_EVIDENCE_MAX_PER_SYMBOL=10

# 完整输入和评估结果的 JSON/Markdown 留档目录（默认不入 git）。
REPORT_DIR=data/reports
